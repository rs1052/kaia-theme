{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "blue",
      "purple",
      "green",
      "orange",
      "yellow",
      "red"
    ],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.200",
      "faint": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.faint",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.200"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$text.faint"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.400",
        "$focused": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$disabled": "$text.faint",
        "$selected": "$hue.interactive.400"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.400"
        },
        "warning": {
          "base": "$hue.orange.400"
        },
        "success": {
          "base": "$hue.green.400"
        },
        "info": {
          "base": "$hue.blue.400"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.600",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.400"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#2B2B2B"
    },
    "scrollbar": {
      "base": "$hue.interactive.400"
    },
    "diff": {
      "text": {
        "added": "$hue.green.400",
        "removed": "$hue.red.400",
        "context": "$text.muted",
        "hunkHeader": "$hue.blue.400"
      },
      "background": {
        "added": "#1D321E",
        "removed": "#3A1D1D",
        "context": "$hue.neutral.900"
      },
      "highlight": {
        "added": "$hue.green.400",
        "removed": "$hue.red.400"
      },
      "lineNumber": {
        "text": "$text.muted",
        "background": {
          "added": "#1D321E",
          "removed": "#3A1D1D"
        }
      }
    },
    "syntax": {
      "comment": "#9E9E9E",
      "keyword": "$hue.red.400",
      "function": "$hue.green.400",
      "variable": "#F5F5F5",
      "string": "$hue.orange.400",
      "number": "$hue.purple.400",
      "type": "$hue.blue.400",
      "operator": "$hue.red.400",
      "punctuation": "#BDBDBD"
    },
    "markdown": {
      "text": "$hue.neutral.100",
      "heading": "$hue.yellow.400",
      "link": "$hue.green.400",
      "linkText": "$hue.blue.400",
      "code": "$hue.orange.400",
      "blockQuote": "$hue.neutral.200",
      "emphasis": "$hue.orange.400",
      "strong": "$hue.yellow.400",
      "horizontalRule": "#2B2B2B",
      "listItem": "$hue.blue.400",
      "listEnumeration": "#B2EBF2",
      "image": "$hue.purple.400",
      "imageText": "$hue.blue.400",
      "codeBlock": "#F5F5F5"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.max"
          },
          "secondary": {
            "$hovered": "$background.raised.max"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#CCCCCC",
        "200": "#8C8C8C",
        "300": "#737373",
        "400": "#5B5B5B",
        "500": "#2B2B2B",
        "600": "#252525",
        "700": "#1A1A1A",
        "800": "#0D0D0D",
        "900": "#000000"
      },
      "red": {
        "100": "#C8BEBE",
        "200": "#94807F",
        "300": "#7F6D6D",
        "400": "#EF9A9A",
        "500": "#936160",
        "600": "#503534",
        "700": "#322828",
        "800": "#161111",
        "900": "#000000"
      },
      "orange": {
        "100": "#C5C0B9",
        "200": "#8F8474",
        "300": "#7B7163",
        "400": "#FFCC80",
        "500": "#96784C",
        "600": "#493A25",
        "700": "#2F2A23",
        "800": "#15120D",
        "900": "#000000"
      },
      "yellow": {
        "100": "#C2C1B9",
        "200": "#888674",
        "300": "#757363",
        "400": "#FFF59D",
        "500": "#918B58",
        "600": "#413E25",
        "700": "#2C2B23",
        "800": "#13120D",
        "900": "#000000"
      },
      "green": {
        "100": "#BEC2BE",
        "200": "#7E897E",
        "300": "#6C756C",
        "400": "#A5D6A7",
        "500": "#648065",
        "600": "#2F4330",
        "700": "#272D28",
        "800": "#101310",
        "900": "#000000"
      },
      "blue": {
        "100": "#BBC2C6",
        "200": "#788891",
        "300": "#66757C",
        "400": "#81D4FA",
        "500": "#4F7F95",
        "600": "#26414E",
        "700": "#242C30",
        "800": "#0E1315",
        "900": "#000000"
      },
      "purple": {
        "100": "#C5BFC5",
        "200": "#8D8090",
        "300": "#7A6E7B",
        "400": "#CE93D8",
        "500": "#815E86",
        "600": "#47364A",
        "700": "#2F2830",
        "800": "#141115",
        "900": "#000000"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.yellow",
      "neutral": "$hue.gray"
    }
  }
}
